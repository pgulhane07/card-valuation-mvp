# Copy this file to .env and fill in your own values.
# .env is gitignored. The scripts do not load .env automatically;
# export these in your shell before running the loader or estimator.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# Your local PostgreSQL password. Do not commit the real value.
PGPASSWORD=your_postgres_password

PGHOST=localhost
PGPORT=5432
PGDATABASE=card_valuation
PGUSER=postgres

# Optional connection string for --dsn. Leave the password out of this
# string and pass it through PGPASSWORD instead.
# DATABASE_DSN=host=localhost port=5432 dbname=card_valuation user=postgres
